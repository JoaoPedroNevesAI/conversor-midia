# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq

# Object Storage (SeaweedFS, API compatível com S3)
# S3_ENDPOINT: usado pelos serviços DENTRO da rede do Docker (api, worker)
# S3_PUBLIC_ENDPOINT: usado só para montar o link que vai no e-mail -- precisa
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=dummy
S3_SECRET_KEY=dummy
BUCKET_UPLOADS=uploads
BUCKET_CONVERTED=converted
PRESIGNED_URL_EXPIRES=86400

# Redis
REDIS_HOST=redis

# SMTP (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=conversor@exemplo.com

# Retentativas
MAX_ATTEMPTS=3